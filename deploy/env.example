# Settings for the site on the Pi. Copy to ~/.config/vandervennet.art.env and fill in.
# The deploy script and pm2 both read it.

# Only listen on the Pi itself; Cloudflare Tunnel connects to this port.
HOST=127.0.0.1
PORT=3020

# The public address. Webmentions must target this host.
NUXT_PUBLIC_SITE_URL=https://vandervennet.art

# Where the guestbook keeps its two JSON lists. Outside the project folder, so a deploy never touches it.
# Use the full path: Node reads this file itself, so $HOME does not work here.
NUXT_GUESTBOOK_DIR=/home/CHANGE-ME/.local/share/vandervennet.art/guestbook

# A long random string. Needed to delete guestbook entries. Make one with: openssl rand -hex 32
NUXT_ADMIN_TOKEN=
