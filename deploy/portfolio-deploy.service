# One run of the deploy script. Started by portfolio-deploy.timer.
#   ~/.config/systemd/user/portfolio-deploy.service
[Unit]
Description=Deploy vandervennet.art when there is a new release

[Service]
Type=oneshot
ExecStart=%h/vandervennet.art/deploy/deploy.sh
# what each deploy did, newest at the bottom
StandardOutput=append:%h/.local/share/vandervennet.art/deploy.log
StandardError=append:%h/.local/share/vandervennet.art/deploy.log
